# Copy to .env (gitignored) for local development. Never commit real values.
# In production these come from AWS Secrets Manager (SECRETS_PROVIDER=aws).

APP_ENV=dev                     # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=true

# --- Trading mode (safety rule 1). Live additionally needs LIVE_TRADING_ENABLED=true.
TRADING_MODE=paper              # paper | live
LIVE_TRADING_ENABLED=false
ALGO_TAG=AQTA-UNREGISTERED      # FR-028 / Q-008: exchange algo identifier from the broker

# --- Infrastructure (docker compose uses the service names below)
DATABASE_URL=postgresql+asyncpg://aqta:aqta@localhost:5432/aqta
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=aqta
POSTGRES_PASSWORD=aqta
POSTGRES_DB=aqta

# --- Secrets provider: env (local) | aws (production)
SECRETS_PROVIDER=env
AWS_REGION=ap-south-1
AWS_SECRET_ID=

# --- API auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
CORS_ORIGINS=[]
MFA_REQUIRED=false

# --- Approval tokens (RULE-001). >= 32 chars, required in prod.
APPROVAL_SECRET=
APPROVAL_TTL_SECONDS=300

# --- Telegram (FR-052). Leave the token empty in dev to use the fake notifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Risk defaults (RULE-002/003, ASM-004; confirm under Q-004)
RISK__CAPITAL_INR=1000000
RISK__MAX_LOSS_PER_TRADE_PCT=1.0
RISK__DAILY_LOSS_LIMIT_PCT=2.0
RISK__MAX_DRAWDOWN_PCT=5.0
RISK__MARGIN_CAP_PCT=60.0
RISK__MAX_OPEN_ORDERS=20
RISK__MAX_ORDERS_PER_SECOND=5
RISK__MAX_LOTS_PER_ORDER=50
RISK__PRICE_BAND_PCT=5.0
RISK__DUPLICATE_WINDOW_SECONDS=30

# --- Monthly budgets in INR (CON-002, FR-053)
BUDGET__DATA_MONTHLY_INR=1000
BUDGET__AI_MONTHLY_INR=2000

# --- Astrology (RULE-014): shadow mode, zero weight
ASTROLOGY__SHADOW_MODE=true
ASTROLOGY__DEFAULT_WEIGHT=0.0

# --- Market sessions in IST (MCX close shifts with US DST)
SESSIONS__MCX_CLOSE=23:30

# --- Tests only: point at a disposable database to run integration tests
AQTA_TEST_DATABASE_URL=
