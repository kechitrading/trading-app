# Copy to .env (gitignored) for local development. Never commit real values.
# In production these come from AWS Secrets Manager (SECRETS_PROVIDER=aws).

# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Trading mode (safety rule 1). Live additionally needs LIVE_TRADING_ENABLED=true.
# paper | live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# FR-028 / Q-008: exchange algo identifier from the broker
ALGO_TAG=AQTA-UNREGISTERED

# --- Infrastructure (docker compose uses the service names below)
DATABASE_URL=postgresql+asyncpg://aqta:aqta@localhost:5432/aqta
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=aqta
POSTGRES_PASSWORD=aqta
POSTGRES_DB=aqta

# --- Secrets provider: env (local) | aws (production)
SECRETS_PROVIDER=env
AWS_REGION=ap-south-1
AWS_SECRET_ID=

# --- API auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
CORS_ORIGINS=[]
# NFR-009: TOTP for sensitive actions (X-TOTP header). Always required in prod.
# Create the secret with: uv run python scripts/mfa_setup.py
MFA_REQUIRED=false
MFA_TOTP_SECRET=

# --- Approval tokens (RULE-001). >= 32 chars, required in prod.
APPROVAL_SECRET=
APPROVAL_TTL_SECONDS=300

# --- Telegram (FR-052). Leave the token empty in dev to use the fake notifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Broker: Angel One SmartAPI (Q-005). From smartapi.angelbroking.com -> My Apps.
# Register the server's Elastic IP on the app (REG-001). TOTP secret = the key shown when you
# enable TOTP for SmartAPI (not a 6-digit code). Paper mode never sends orders.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_MPIN=
ANGEL_ONE_TOTP_SECRET=

# --- AI: Anthropic Claude (Q-010). From console.anthropic.com -> API keys.
# Also set a monthly spend limit in the console to match BUDGET__AI_MONTHLY_INR.
ANTHROPIC_API_KEY=
# Any Claude model ID works. Current ones (USD per 1M tokens, input / output):
#   claude-fable-5-1   most capable          10.00 / 50.00
#   claude-opus-5-5    strong, default        4.00 / 20.00
#   claude-sonnet-5-5  balanced               2.00 / 10.00
#   claude-haiku-5-5   cheapest, fastest      0.10 /  0.50
# LLM_MODEL: reports, deep dives, advice. LLM_MODEL_ROUTINE: summaries, news tagging.
LLM_MODEL=claude-opus-5-5
LLM_MODEL_ROUTINE=claude-opus-5-5

# --- News and global macro: Finnhub (Q-001). From finnhub.io -> Dashboard.
FINNHUB_API_KEY=

# --- Risk limits (RULE-002/003, ASM-004; confirmed by Kashyap 2026-10-18, D-012)
RISK__CAPITAL_INR=1000000
RISK__MAX_LOSS_PER_TRADE_PCT=1.0
RISK__DAILY_LOSS_LIMIT_PCT=2.0
RISK__MAX_DRAWDOWN_PCT=5.0
RISK__MARGIN_CAP_PCT=60.0
RISK__MAX_OPEN_ORDERS=20
RISK__MAX_ORDERS_PER_SECOND=5
RISK__MAX_LOTS_PER_ORDER=50
RISK__PRICE_BAND_PCT=5.0
RISK__DUPLICATE_WINDOW_SECONDS=30

# --- Monthly budgets in INR (CON-002, FR-053)
BUDGET__DATA_MONTHLY_INR=1000
BUDGET__AI_MONTHLY_INR=2000

# --- Astrology (RULE-014): shadow mode, zero weight
ASTROLOGY__SHADOW_MODE=true
ASTROLOGY__DEFAULT_WEIGHT=0.0

# --- Market sessions in IST (MCX close shifts with US DST)
SESSIONS__MCX_CLOSE=23:30

# --- Tests only: point at a disposable database to run integration tests
AQTA_TEST_DATABASE_URL=
